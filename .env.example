# ==============================================================================
# Sovereign Cloud 3-Tier Application - Environment Configuration Template
# All settings below are configured for standard local container orchestration
# ==============================================================================

# Database Configuration (PostgreSQL Sovereign Tier)
POSTGRES_DB=sovereign_cloud_db
POSTGRES_USER=cloud_admin
POSTGRES_PASSWORD=SovereignSecurePass2030!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# Web Gateway / Ingress Port
WEB_PORT=80
